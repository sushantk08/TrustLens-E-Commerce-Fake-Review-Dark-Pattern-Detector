{
  "manifest_version": 3,
  "name": "TrustLens - E-Commerce Review & Dark Pattern Detector",
  "version": "1.0.0",
  "description": "Expose fake review rings, bot clusters, and deceptive patterns on Amazon, Flipkart, and Google Maps.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.google.com/maps/*",
    "*://*.google.co.in/maps/*",
    "*://maps.google.com/*",
    "*://maps.app.goo.gl/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check TrustLens Score"
  }
}